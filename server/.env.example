# Keep this file in the backend only. Never add this key to client/.env.
GROQ_API_KEY=your_groq_api_key
# Optional vision-capable model override
GROQ_MODEL=qwen/qwen3.8-27b
PORT=5000SUPABASE_URL=https://your-project.supabase.co
# Server only. It may bypass RLS, so API routes verify each bearer token and scope queries by user_id.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Used only to validate browser bearer tokens.
SUPABASE_ANON_KEY=your_supabase_anon_key
